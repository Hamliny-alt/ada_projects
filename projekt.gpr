project Projekt is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Main use ("main.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-O2", "-gnatwa", "-gnatwe", "-gnatyyM");
   end Compiler;

   package Prove is
      for Prove_Switches use ("--level=1", "--prover=z3,cvc4");
   end Prove;
end Projekt;
